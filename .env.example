# Leave blank for local dev -- requests then go to relative paths ("/api/...")
# which Vite's own dev-server proxy (see vite.config.js) forwards to the
# backend on :8000. An explicit absolute URL here makes the browser treat the
# API as a different origin than the frontend, which triggers a CORS
# preflight OPTIONS request before every POST/PUT/PATCH/DELETE -- harmless,
# but avoidable. Only set this if the API is genuinely served from a
# different origin than the frontend.
VITE_API_BASE_URL=

# Optional — leave blank until the client provides a GA4 property. Analytics
# tracking (frontend/src/lib/siteMetrics.js) no-ops gracefully without it.
VITE_GA_MEASUREMENT_ID=

# Optional — set to "true" to show the public site's maintenance screen
# (frontend/src/pages/Maintenance.jsx) during a deploy/upgrade window. The
# admin panel stays reachable regardless. Leave unset the rest of the time.
VITE_MAINTENANCE_MODE=
